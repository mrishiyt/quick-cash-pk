<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quick Cash PK - Admin Panel</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; }
        body { background-color: #121212; color: #ffffff; padding: 20px; }
        .container { max-width: 900px; margin: 0 auto; }
        h1 { text-align: center; color: #00e676; margin-bottom: 20px; }
        
        /* Login Box */
        .login-box { background: #1e1e1e; padding: 30px; border-radius: 10px; max-width: 400px; margin: 50px auto; text-align: center; border: 1px solid #333; }
        input { width: 100%; padding: 12px; margin: 10px 0; border-radius: 6px; border: 1px solid #444; background: #2a2a2a; color: white; font-size: 16px; outline: none; }
        button { width: 100%; padding: 12px; background: #00e676; color: #000; border: none; font-weight: bold; border-radius: 6px; cursor: pointer; font-size: 16px; margin-top: 10px; }
        button:hover { background: #00c853; }

        /* Dashboard */
        .hidden { display: none; }
        .header-bar { display: flex; justify-content: space-between; align-items: center; background: #1e1e1e; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        
        /* Requests Table / Cards */
        .request-card { background: #1e1e1e; border: 1px solid #333; padding: 15px; border-radius: 8px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        .req-info p { margin: 4px 0; font-size: 14px; color: #ccc; }
        .req-info strong { color: #fff; }
        .badge { background: #ff9800; color: #000; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 12px; }
        .badge.completed { background: #4caf50; color: #fff; }
        .badge.rejected { background: #f44336; color: #fff; }

        .action-btns { display: flex; gap: 10px; }
        .btn-approve { background: #4caf50; color: white; padding: 8px 15px; border-radius: 5px; border: none; cursor: pointer; font-weight: bold; }
        .btn-reject { background: #f44336; color: white; padding: 8px 15px; border-radius: 5px; border: none; cursor: pointer; font-weight: bold; }
        .btn-approve:hover { background: #388e3c; }
        .btn-reject:hover { background: #d32f2f; }
    </style>

    <!-- Firebase SDK (Compat Version) -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>
</head>
<body>

    <div class="container">
        
        <!-- ADMIN LOGIN FORM -->
        <div id="loginSection" class="login-box">
            <h2>👑 Admin Login</h2>
            <p style="color: #aaa; margin-top: 5px; font-size: 14px;">Secret Passcode Daalein</p>
            <input type="password" id="adminPass" placeholder="Admin Passcode">
            <button onclick="checkAdminPass()">Login Panel</button>
        </div>

        <!-- ADMIN DASHBOARD -->
        <div id="dashboardSection" class="hidden">
            <div class="header-bar">
                <h2>📋 Pending Withdrawal Requests</h2>
                <button onclick="location.reload()" style="width: auto; padding: 8px 15px;">🔄 Refresh</button>
            </div>

            <div id="requestsList">
                <p style="text-align: center; color: #888;">Requests load ho rahi hain...</p>
            </div>
        </div>

    </div>

    <script>
        // Firebase Config
        const firebaseConfig = {
            apiKey: "AIzaSyBhqMGeizGgz16jDn2_CS4cRfToFjLb8kM",
            authDomain: "quick-cash-pk.firebaseapp.com",
            projectId: "quick-cash-pk",
            storageBucket: "quick-cash-pk.firebasestorage.app",
            messagingSenderId: "506832360758",
            appId: "1:506832360758:web:2fa52e7df9a1f99793cf97"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        // Secret Admin Passcode (Isko badal bhi sakte hain)
        const ADMIN_PASSCODE = "ADMIN786";

        function checkAdminPass() {
            const pass = document.getElementById('adminPass').value.trim();
            if (pass === ADMIN_PASSCODE) {
                document.getElementById('loginSection').classList.add('hidden');
                document.getElementById('dashboardSection').classList.remove('hidden');
                loadWithdrawals();
            } else {
                alert("Ghalat Admin Passcode!");
            }
        }

        // Load Withdrawal Requests from Firestore
        function loadWithdrawals() {
            const listDiv = document.getElementById('requestsList');
            
            db.collection("withdrawals").onSnapshot((snapshot) => {
                listDiv.innerHTML = "";
                
                if (snapshot.empty) {
                    listDiv.innerHTML = "<p style='text-align:center; color:#aaa;'>Koi withdrawal request nahi hai.</p>";
                    return;
                }

                snapshot.docs.forEach(doc => {
                    const data = doc.data();
                    const docId = doc.id;

                    const statusClass = data.status === 'Completed' ? 'completed' : (data.status === 'Rejected' ? 'rejected' : '');
                    
                    let actionButtons = '';
                    if (data.status === 'Pending') {
                        actionButtons = `
                            <div class="action-btns">
                                <button class="btn-approve" onclick="approveRequest('${docId}')">Approve</button>
                                <button class="btn-reject" onclick="rejectRequest('${docId}', '${data.username}', ${data.appPoints})">Reject</button>
                            </div>
                        `;
                    }

                    const cardHTML = `
                        <div class="request-card">
                            <div class="req-info">
                                <p><strong>User:</strong> ${data.username} <span class="badge ${statusClass}">${data.status}</span></p>
                                <p><strong>Method:</strong> ${data.method}</p>
                                <p><strong>Title:</strong> ${data.accountName}</p>
                                <p><strong>Number:</strong> <span style="color:#00e676; font-size:16px; font-weight:bold;">${data.accountNumber}</span></p>
                                <p><strong>Amount:</strong> ${data.pkrAmount} PKR (${data.appPoints} App Points)</p>
                                <p><small style="color:#666;">Date: ${data.date || 'N/A'}</small></p>
                            </div>
                            ${actionButtons}
                        </div>
                    `;
                    listDiv.innerHTML += cardHTML;
                });
            });
        }

        // Approve Request Function
        async function approveRequest(docId) {
            if (confirm("Kya aap ne is user ko paise bhej diye hain aur request Approve karna chahte hain?")) {
                try {
                    await db.collection("withdrawals").doc(docId).update({
                        status: "Completed"
                    });
                    alert("Request Successful Approve ho gayi!");
                } catch (error) {
                    alert("Error: " + error.message);
                }
            }
        }

        // Reject Request Function (Refunds App Points back to user)
        async function rejectRequest(docId, username, appPoints) {
            if (confirm("Request Reject karne par user ke points uske account mein wapas chale jayenge. Continue karein?")) {
                try {
                    // Update status to Rejected
                    await db.collection("withdrawals").doc(docId).update({
                        status: "Rejected"
                    });

                    // Refund balance back to user
                    const userRef = db.collection("users").doc(username);
                    const userDoc = await userRef.get();
                    if (userDoc.exists) {
                        const currentBal = userDoc.data().balance || 0;
                        await userRef.update({
                            balance: currentBal + appPoints
                        });
                    }

                    alert("Request Reject kar di gayi aur Points user ko refund ho gaye!");
                } catch (error) {
                    alert("Error: " + error.message);
                }
            }
        }
    </script>
</body>
</html>
